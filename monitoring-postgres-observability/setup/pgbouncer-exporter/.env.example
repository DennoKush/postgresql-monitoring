# pgbouncer_exporter environment file
# Copy to /etc/pgbouncer-exporter/.env and set permissions: chmod 600

# PgBouncer admin database connection string
# Database name must be "pgbouncer" (PgBouncer's internal admin database)
# Host and port must point to PgBouncer, NOT PostgreSQL
DATA_SOURCE_NAME="postgresql://pgb_exporter:CHANGE_ME@localhost:6432/pgbouncer?sslmode=disable"

# Optional: Override the default listen address
# Use 0.0.0.0:9127 when Prometheus is on a separate host
# Use 127.0.0.1:9127 when Prometheus is on the same host
# PGBOUNCER_EXPORTER_WEB_LISTEN_ADDRESS="0.0.0.0:9127"
