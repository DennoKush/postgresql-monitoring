[Unit]
Description=Prometheus PgBouncer Exporter
Documentation=https://github.com/prometheus-community/pgbouncer_exporter
After=network.target pgbouncer.service
Wants=pgbouncer.service

[Service]
Type=simple
User=pgb_exporter
Group=pgb_exporter

# Load PgBouncer admin connection string from the secure environment file
EnvironmentFile=/etc/pgbouncer-exporter/.env

ExecStart=/usr/local/bin/pgbouncer_exporter \
  --web.listen-address=0.0.0.0:9127 \
  --web.telemetry-path=/metrics \
  --log.level=info

Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
