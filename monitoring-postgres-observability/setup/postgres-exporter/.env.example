# postgres_exporter environment file
# Copy to /etc/postgres_exporter/.env and set permissions: chmod 600

# PostgreSQL connection string for the monitoring user
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?<options>
DATA_SOURCE_NAME="postgresql://monitoring_user:CHANGE_ME@localhost:5432/postgres?sslmode=disable"

# Optional: Override the default listen address (default: 0.0.0.0:9187)
# Use 0.0.0.0:9187 when Prometheus is on a separate host
# Use 127.0.0.1:9187 when Prometheus is on the same host
# PG_EXPORTER_WEB_LISTEN_ADDRESS="0.0.0.0:9187"

# Optional: Custom metrics file path (leave unset to use built-in metrics only)
# PG_EXPORTER_EXTEND_QUERY_PATH="/etc/postgres_exporter/custom_queries.yaml"
